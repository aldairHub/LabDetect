<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LabDetect" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lab_teal</item>
        <item name="colorOnPrimary">@color/lab_navy</item>
        <item name="colorSecondary">@color/lab_violet</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/lab_card_dark</item>
        <item name="colorOnSurface">@color/lab_text_dark</item>
        <item name="colorSurfaceVariant">@color/lab_navy_soft</item>
        <item name="android:colorAccent">@color/lab_teal</item>
        <item name="android:windowBackground">@color/lab_surface_dark</item>
        <item name="android:statusBarColor">@color/lab_navy</item>
        <item name="android:navigationBarColor">@color/lab_navy</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
