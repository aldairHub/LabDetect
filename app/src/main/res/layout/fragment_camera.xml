<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lab_navy">
<androidx.camera.view.PreviewView android:id="@+id/viewFinder" android:layout_width="match_parent" android:layout_height="match_parent" app:scaleType="fillCenter"/>
<com.example.labdetect.DetectionOverlayView android:id="@+id/detectionOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="yes"/>
<View android:layout_width="0dp" android:layout_height="100dp" android:background="@drawable/bg_camera_top_scrim" android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<TextView android:id="@+id/brandTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Bromatología · UTEQ" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white" android:maxLines="2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnFavoritesList" app:layout_constraintTop_toTopOf="@id/btnFavoritesList" app:layout_constraintBottom_toBottomOf="@id/btnFavoritesList"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnFavoritesList" style="@style/LabGlassIcon" android:contentDescription="Abrir favoritos y recientes" app:srcCompat="@drawable/ic_star_outline" android:layout_marginEnd="8dp" android:layout_marginTop="8dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
<TextView android:id="@+id/tvScanStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Apunta a un equipo del laboratorio" android:textColor="@color/lab_muted_dark" android:textSize="12sp" android:accessibilityLiveRegion="polite" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnFavoritesList"/>
<androidx.core.widget.NestedScrollView android:id="@+id/conversationScroll" android:layout_width="0dp" android:layout_height="wrap_content" android:fillViewport="false" android:clipToPadding="false" android:scrollbars="none" android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" app:layout_constrainedHeight="true" app:layout_constraintWidth_max="600dp" app:layout_constraintVertical_bias="1" app:layout_constraintTop_toBottomOf="@id/tvScanStatus" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<com.example.labdetect.GlassPanel android:id="@+id/answerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivEquipmentThumb" android:layout_width="44dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@drawable/ic_book" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/LabRoundedShape"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/tvCameraAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lab_text" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" android:lineSpacingExtra="2dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnDetails" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" android:text="Ver detalle" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/lab_teal"/>
</LinearLayout>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnDismissAnswer" style="@style/LabGlassIcon" android:contentDescription="Ocultar tarjeta" app:srcCompat="@drawable/ic_close" android:layout_gravity="top"/>
</LinearLayout></com.example.labdetect.GlassPanel>
<TextView android:id="@+id/tvQuestionPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="¿Qué deseas saber del equipo?" android:textColor="@color/lab_text" android:textSize="14sp" android:layout_marginBottom="12dp" android:background="@drawable/bg_glass" android:paddingHorizontal="16dp" android:paddingVertical="10dp" android:gravity="center" android:visibility="gone"/>
<TextView android:id="@+id/tvVoiceState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lab_text" android:textSize="14sp" android:layout_marginBottom="8dp" android:gravity="center" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
<LinearLayout android:id="@+id/feedbackBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
<TextView android:id="@+id/tvFeedbackPrompt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/lab_muted_dark"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackYes" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Sí" android:minWidth="48dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackCorrect" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Corregir" android:textAllCaps="false"/>
</LinearLayout>
<com.example.labdetect.GlassPanel android:id="@+id/conversationCard" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp" android:gravity="center_vertical">
<com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabMic" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Hablar; toca otra vez para enviar" app:fabCustomSize="48dp" app:backgroundTint="@android:color/transparent" app:elevation="0dp" app:borderWidth="0dp" app:srcCompat="@drawable/ic_mic" app:tint="@color/lab_text"/>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilCameraQuestion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:boxBackgroundMode="none" app:hintEnabled="false">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tietCameraQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@null" android:paddingHorizontal="8dp" android:paddingVertical="10dp" android:textSize="14sp" android:textColor="@color/lab_text" android:textColorHint="@color/lab_muted" android:hint="Escribe o pregunta por voz" android:inputType="textCapSentences" android:imeOptions="actionSend" android:maxLines="3"/>
</com.google.android.material.textfield.TextInputLayout>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSendQuestion" style="@style/LabGlassIcon" android:contentDescription="Enviar pregunta" app:srcCompat="@drawable/ic_send" app:tint="@color/lab_navy" android:background="@drawable/bg_send"/>
</LinearLayout></com.example.labdetect.GlassPanel>
<TextView android:id="@+id/tvMicHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/lab_text" android:textSize="14sp" android:paddingTop="8dp" android:gravity="center" android:visibility="gone"/>
<ProgressBar android:id="@+id/pbAssistant" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="6dp" android:indeterminate="true" android:indeterminateTint="@color/lab_teal" android:visibility="gone"/>
</LinearLayout></androidx.core.widget.NestedScrollView></androidx.constraintlayout.widget.ConstraintLayout>
